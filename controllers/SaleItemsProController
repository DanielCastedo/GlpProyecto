<?php

namespace Controllers;

use Core\Controller;
use Core\Database;

class SaleItemsProController extends Controller
{
    // Muestra el formulario
    public function create()
    {
        $pdo = Database::pdo();
        // Obtener productos, choferes y rutas para selects
        $products = $pdo->query("SELECT id, name FROM products ORDER BY name")->fetchAll(\PDO::FETCH_ASSOC);
        $drivers = $pdo->query("SELECT id, name FROM drivers ORDER BY name")->fetchAll(\PDO::FETCH_ASSOC);
        $routes = $pdo->query("SELECT id, name FROM routes ORDER BY name")->fetchAll(\PDO::FETCH_ASSOC);

        $this->render('ventas/create', compact('products', 'drivers', 'routes'));
    }

    // Procesa y guarda la venta con los ítems
    public function store()
    {
        $pdo = Database::pdo();
        $pdo->beginTransaction();
        try {
            // Guardar la venta principal
            $stmt = $pdo->prepare("INSERT INTO sales (date, customer_name, customer_phone, driver_id, route_id, total, amount_paid, balance_due, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)");
            $stmt->execute([
                $_POST['date'],
                $_POST['customer_name'],
                $_POST['customer_phone'],
                $_POST['driver_id'],
                $_POST['route_id'],
                $_POST['total'],
                $_POST['amount_paid'],
                $_POST['balance_due'],
                'pending'
            ]);
            $sale_id = $pdo->lastInsertId();

            // Ítems: items[0]['product_id'], items[0]['qty'], items[0]['unit_price'], items[0]['subtotal'], ...
            foreach ($_POST['items'] as $item) {
                $stmt = $pdo->prepare("INSERT INTO sale_items (sale_id, product_id, qty, unit_price, subtotal) VALUES (?, ?, ?, ?, ?)");
                $stmt->execute([
                    $sale_id,
                    $item['product_id'],
                    $item['qty'],
                    $item['unit_price'],
                    $item['subtotal']
                ]);
            }
            $pdo->commit();
            // Redirigir a la edición de la venta recién creada
            header("Location: " . $this->baseUrl() . "/sales/edit?id=$sale_id");
            exit;
        } catch (\Exception $e) {
            $pdo->rollBack();
            echo "<div style='color:red'>Error al registrar venta: " . $e->getMessage() . "</div>";
        }
    }

    public function agregar_items()
    {
        $pdo = Database::pdo();
        $sale_id = (int)($_GET['sale_id'] ?? 0);
        // Obtener productos para el select
        $products = $pdo->query("SELECT id, name FROM products ORDER BY name")->fetchAll(\PDO::FETCH_ASSOC);
        $this->render('ventas/agregar_items', compact('sale_id', 'products'));
    }

    public function store_items()
    {
        $pdo = Database::pdo();
        $pdo->beginTransaction();
        try {
            $sale_id = (int)$_POST['sale_id'];
            $total = 0;
            foreach ($_POST['items'] as $item) {
                $stmt = $pdo->prepare("INSERT INTO sale_items (sale_id, product_id, qty, unit_price, subtotal) VALUES (?, ?, ?, ?, ?)");
                $stmt->execute([
                    $sale_id,
                    $item['product_id'],
                    $item['qty'],
                    $item['unit_price'],
                    $item['subtotal']
                ]);
                $total += $item['subtotal'];
            }
            // Actualizar el total de la venta
            $stmt = $pdo->prepare("UPDATE sales SET total = ? WHERE id = ?");
            $stmt->execute([$total, $sale_id]);
            $pdo->commit();
            header("Location: " . $this->baseUrl() . "/sales/edit?id=$sale_id");
            exit;
        } catch (\Exception $e) {
            $pdo->rollBack();
            echo "<div style='color:red'>Error al guardar ítems: " . $e->getMessage() . "</div>";
        }
    }
}
